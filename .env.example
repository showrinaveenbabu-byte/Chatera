# Vercel Deployment & Global Environment Variables

# MongoDB Connection String (Set in Vercel Project Settings -> Environment Variables)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/communication_app?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=generate_a_secure_jwt_secret_key_here

# Frontend Configuration (Optional on Vercel if hosting fullstack on same domain)
# VITE_API_URL=
# VITE_SOCKET_URL=https://your-socket-server.onrender.com
