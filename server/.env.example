# Server Environment Variables
PORT=5000

# MongoDB Connection String (Atlas recommended for Vercel production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/communication_app?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=generate_a_secure_jwt_secret_key_here

# JWT Token Expiry (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Environment Mode
NODE_ENV=development
